{
  "name": "@reviseflow/pulse",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/generate-contracts.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@reviseflow/pulse-core": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "description": "Cloud-optional metadata-only analytics for observed MCP tool handlers.",
  "homepage": "https://github.com/selimeneserd/pulse-sdk#readme",
  "keywords": [
    "mcp",
    "analytics",
    "model-context-protocol",
    "pulse",
    "telemetry"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimeneserd/pulse-sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/selimeneserd/pulse-sdk/issues"
  },
  "bin": {
    "pulse": "./dist/cli.js"
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse v1 admission batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "event-v1.schema.json"
      }
    }
  }
}
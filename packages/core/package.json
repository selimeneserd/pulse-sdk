{
  "name": "@reviseflow/pulse-core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "files": [
    "dist",
    "contracts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/event-v1.schema.json": "./contracts/event-v1.schema.json",
    "./contracts/batch-v1.schema.json": "./contracts/batch-v1.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "description": "Bounded, metadata-only analytics exporter for observed MCP tool handler calls.",
  "homepage": "https://pulse.reviseflow.io/en/docs",
  "keywords": [
    "mcp",

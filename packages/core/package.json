{
  "name": "@reviseflow/pulse-core",
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "files": [
    "dist",
    "contracts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/event-v1.schema.json": "./contracts/event-v1.schema.json",
    "./contracts/batch-v1.schema.json": "./contracts/batch-v1.schema.json",
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./jsonl": {
      "types": "./dist/jsonl.d.ts",
      "import": "./dist/jsonl.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./contracts/ack-v1.schema.json": "./contracts/ack-v1.schema.json"
  },
  "scripts": {
    "build": "node ../../scripts/generate-contracts.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "description": "Explicit local and HTTP exporters for bounded MCP metadata analytics. / Sınırlı MCP metaveri analitiği için yerel ve HTTP exporter’ları.",
  "homepage": "https://github.com/selimeneserd/pulse-sdk#readme",
  "keywords": [
    "mcp",
    "analytics",
    "model-context-protocol",
    "pulse",
    "telemetry",
    "monitoring",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimeneserd/pulse-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/selimeneserd/pulse-sdk/issues"
  }
}
